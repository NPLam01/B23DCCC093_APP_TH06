{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "conversations": {
      "$chatId": {
        ".read": "auth != null && (data.child('members/' + auth.uid).val() === true || $chatId.contains(auth.uid))",
        ".write": "auth != null && (data.child('members/' + auth.uid).val() === true || $chatId.contains(auth.uid))"
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || $chatId.contains(auth.uid))"
        }
      }
    }
  }
}
